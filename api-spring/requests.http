###
### FinanKal REST API Test Suite
### Spring Boot REST -> gRPC -> Go Finance Engine
### Base URL: http://localhost:8080
###

###########################################################
# HEALTH
###########################################################

###
GET http://localhost:8080/actuator/health
Accept: application/json


### Get Account Summary
GET http://localhost:8080/api/accounts/11111111-1111-1111-1111-111111111111
Accept: application/json



### Get Account Balance
GET http://localhost:8080/api/accounts/11111111-1111-1111-1111-111111111111/balance
Accept: application/json



### Get Credit Card Account Summary
GET http://localhost:8080/api/accounts/44444444-4444-4444-4444-444444444444
Accept: application/json



### Get Ledger Entries
GET http://localhost:8080/api/ledger-entries/11111111-1111-1111-1111-111111111111
Accept: application/json



### Get user total credit
GET http://localhost:8080/api/users/bcc539f6-fc94-4a2e-9ce6-3c03c0560204/total-credit
Accept: application/json

### Get user total debit

GET http://localhost:8080/api/users/bcc539f6-fc94-4a2e-9ce6-3c03c0560204/total-debit
Accept: application/json

###get user total balance

GET http://localhost:8080/api/users/bcc539f6-fc94-4a2e-9ce6-3c03c0560204/net-worth
Accept: application/json

### Get User Accounts
GET http://localhost:8080/api/users/bcc539f6-fc94-4a2e-9ce6-3c03c0560204/accounts
Accept: application/json

### Get Clearing Account Summary
GET http://localhost:8080/api/accounts/55555555-5555-5555-5555-555555555555
Accept: application/json


### Get Clearing Account Balance
GET http://localhost:8080/api/accounts/55555555-5555-5555-5555-555555555555/balance
Accept: application/json



### Get CC Summary
GET http://localhost:8080/api/accounts/1a1a1a1a-1a1a-1a1a-1a1a-1a1a1a1a1a1a
Accept: application/json

###

### Get CC Account Balance

GET http://localhost:8080/api/accounts/1a1a1a1a-1a1a-1a1a-1a1a-1a1a1a1a1a1a/balance
Accept: application/json

###
POST http://localhost:8080/api/transactions
Content-Type: application/json

{
  "description": "Cash Transfer",
  "entries": [
    {
      "accountId": "11111111-1111-1111-1111-111111111111",
      "amount": 500.00,
      "type": "DEBIT"
    },
    {
      "accountId": "22222222-2222-2222-2222-222222222222",
      "amount": 500.00,
      "type": "CREDIT"
    }
  ]
}

###

POST http://localhost:8080/api/transactions
Content-Type: application/json

{
  "description": "Salary Distribution",
  "entries": [
    {
      "accountId": "11111111-1111-1111-1111-111111111111",
      "amount": 5000.00,
      "type": "DEBIT"
    },
    {
      "accountId": "22222222-2222-2222-2222-222222222222",
      "amount": 2500.00,
      "type": "CREDIT"
    },
    {
      "accountId": "33333333-3333-3333-3333-333333333333",
      "amount": 2500.00,
      "type": "CREDIT"
    }
  ]
}

###########################################################
# CREDIT CARDS
###########################################################

###
### Auto Create Account
POST http://localhost:8080/api/credit-cards
Content-Type: application/json

{
  "accountName": "BPI Platinum Rewards",
  "creditLimit": 50000,
  "billingDay": 15,
  "paymentDueDays": 21
}

###

### Existing Credit Card Account
POST http://localhost:8080/api/credit-cards
Content-Type: application/json

{
  "accountId": "44444444-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
  "creditLimit": 100000,
  "billingDay": 15,
  "paymentDueDays": 21
}

