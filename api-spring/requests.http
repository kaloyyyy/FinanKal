###########################################################
# STATEMENTS
###########################################################

###
GET http://localhost:8080/api/credit-cards/statements/99999999-9999-9999-9999-999999999999
Accept: application/json

###########################################################
# PAYMENTS
###########################################################

###
POST http://localhost:8080/api/credit-cards/payment
Content-Type: application/json

{
  "statementId": "99999999-9999-9999-9999-999999999999",
  "cardId": "1a1a1a1a-1a1a-1a1a-1a1a-1a1a1a1a1a1a",
  "paymentAccountId": "11111111-1111-1111-1111-111111111111",
  "amount": 5000,
  "description": "Partial payment"
}

###

POST http://localhost:8080/api/credit-cards/payment
Content-Type: application/json

{
  "statementId": "99999999-9999-9999-9999-999999999999",
  "cardId": "1a1a1a1a-1a1a-1a1a-1a1a-1a1a1a1a1a1a",
  "paymentAccountId": "11111111-1111-1111-1111-111111111111",
  "amount": 50000,
  "description": "Full payment"
}

